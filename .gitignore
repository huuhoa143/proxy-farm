# Local settings written by run.sh (contains paths on your machine)
.env

# Credentials and VPN configs must never be committed
secrets/
*.p12
*.pfx
*.key
*.pem
!node/ca/*.pem
# v2 providers module: public root/shared CA material and tls-auth key,
# bundled for HMA/ZoogVPN OpenVPN (spec §5.1/§5.2) — not secrets.
!app/resources/ca/*.pem
!app/resources/ca/*.key
*.conf
*.ovpn
# v2 providers module: synthetic (non-real) .ovpn/.conf fixtures for the
# file-import provider's unit tests (spec §5.4).
!app/src/main/providers/file/fixtures/*.ovpn
!app/src/main/providers/file/fixtures/*.conf
tokenCoreSE.json
device.json
p12pass

# Runtime data (lives in $FARM, outside the repo, but just in case)
data/
!site/src/data/
status/
configs/
inbox/
manager/data/
manager/farm-state.json

# Tooling
__pycache__/
*.pyc
.DS_Store
.playwright-mcp/
.codegraph/

# Desktop app (app/, electron-forge + Vite) build artifacts
app/node_modules/
app/out/
app/.vite/
app/test-results/

# Local release pipeline scratch (scripts/local-release.sh, release-with-x64.sh)
.release-state*.json
.release-keep/
