client
dev tun
proto udp
remote vpn.example.net 1194
cipher AES-256-GCM
auth SHA256
resolv-retry infinite
nobind
persist-key
persist-tun
persist-remote-ip
<ca>
-----BEGIN CERTIFICATE-----
RkFLRS1DQS1OT1QtQS1SRUFMLUNFUlQtZm9yLXRlc3Rpbmctb25seS1wbGVhc2Ut
ZG8tbm90LXVzZS1pbi1wcm9kdWN0aW9uLWVudmlyb25tZW50cy1hdC1hbGw=
-----END CERTIFICATE-----
</ca>
fast-io
auth-user-pass
reneg-sec 0
reneg-bytes 0
verb 3
key-direction 1
<tls-auth>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----
RkFLRS1UQS1LRVktTk9ULUEtUkVBTC1LRVktZm9yLXRlc3Rpbmctb25seS1wbGVh
c2UtZG8tbm90LXVzZS1pbi1wcm9kdWN0aW9uLWVudmlyb25tZW50cy1hdC1hbGw=
-----END OpenVPN Static key V1-----
</tls-auth>
remote-cert-tls server
auth-nocache
explicit-exit-notify 2
